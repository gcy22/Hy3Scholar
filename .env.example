# Tencent Cloud TokenHub (mainland China endpoint)
HY3_API_KEY=replace_with_your_tokenhub_key
HY3_BASE_URL=https://tokenhub.tencentmaas.com/v1
HY3_MODEL=hy3

# Hy3 supports no_think, low, and high. Evidence verification defaults to high.
HY3_REASONING_EFFORT=high
HY3_TEMPERATURE=0.2
HY3_TOP_P=1.0
HY3_TIMEOUT_SECONDS=180
HY3_MAX_RETRIES=3
HY3_WEB_SEARCH_SOURCE=lite

HY3SCHOLAR_STORAGE_DIR=./data
HY3SCHOLAR_MAX_PARALLEL_EVALUATORS=3
HY3SCHOLAR_UNCERTAINTY_THRESHOLD=0.72
HY3SCHOLAR_LITERATURE_TIMEOUT_SECONDS=30
HY3SCHOLAR_LITERATURE_MAX_RETRIES=2
HY3SCHOLAR_MAX_DOWNLOADS=10
HY3SCHOLAR_MAX_PDF_BYTES=52428800
HY3SCHOLAR_ARXIV_MIN_INTERVAL_SECONDS=3

# OpenAlex supports small anonymous requests; a free key raises the quota.
OPENALEX_API_KEY=
OPENALEX_MAILTO=
CROSSREF_MAILTO=
